<Window x:Class="BorderNext.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{x:Static res:Strings.Login_Title}"
        Height="420" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.App_Title}"
                   FontSize="30" FontWeight="Bold" Foreground="{StaticResource ThemePrimaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Login_Subtitle}"
                   FontSize="13" Foreground="#666" Margin="0,4,0,22"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.Login_UserName}" Margin="0,0,0,4"/>
            <TextBox x:Name="UserNameBox" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.Login_Password}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{x:Static res:Strings.Login_Language}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="LanguageCombo" Width="150" SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="Français" Tag="fr" IsSelected="True"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#C00000" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" VerticalAlignment="Top">
            <Button Content="{x:Static res:Strings.Login_Button}" Style="{StaticResource PrimaryButton}"
                    Height="40" FontSize="15" Click="Login_Click" IsDefault="True"/>
            <Button x:Name="BiometricsBtn" Content="{res:Str Key=Login_Biometrics}"
                    Padding="12,8" Margin="0,10,0,0" Click="Biometrics_Click"/>
        </StackPanel>
    </Grid>
</Window>

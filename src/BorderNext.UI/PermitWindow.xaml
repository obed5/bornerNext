<Window x:Class="BorderNext.UI.PermitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=Permit_Title}"
        Height="840" Width="1240"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="{res:Str Key=PAL_Search}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="SearchDocument_Click"/>
                <Button Content="{res:Str Key=Common_New}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="New_Click"/>
                <Button Content="{res:Str Key=Permit_SaveHeader}" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,12,0" Click="SaveHeader_Click"/>
                <Button x:Name="RevokeBtn" Content="{res:Str Key=Common_Revoke}" Style="{StaticResource ToolbarButton}" Click="Revoke_Click"/>
                <TextBlock x:Name="HolderText" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#4A5568"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{res:Str Key=PAL_Close}" Padding="16,8" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- ===================== PERMIS ===================== -->
            <TabItem Header="{res:Str Key=Permit_Section_Header}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_Type}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TypeCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_Number}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NumberBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{res:Str Key=Permit_Status}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=PAL_IssueDate}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="IssuePicker" Margin="0,0,12,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=PAL_ExpireDate}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ExpirePicker" Margin="0,0,12,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="{res:Str Key=Permit_Visa}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VisaCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_MaritalStatus}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="MaritalCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_Occupation}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="OccupationCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="{res:Str Key=Permit_OccupationOther}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OccupationOtherBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_Qualification}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="QualificationCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_CourseOfStudy}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CourseCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock Text="{res:Str Key=Permit_BloodType}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="BloodCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="{res:Str Key=Permit_IssuingAuthority}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IssuingAuthorityBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="{res:Str Key=PAL_Note}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NoteBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== DÉTAILS ===================== -->
            <TabItem Header="{res:Str Key=Permit_Section_Details}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Permit_CurrentAddress}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CurrentAddressBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Permit_CurrentTown}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CurrentTownBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Permit_CurrentPhone}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CurrentPhoneBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Admin_Col_Country}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CurrentCountryCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Admin_Geo_Provinces}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CurrentProvinceCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Admin_Geo_Cities}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CurrentCityCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Permit_PreviousAddress}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PreviousAddressBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Permit_PreviousTown}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PreviousTownBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Permit_PreviousPostal}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PreviousPostalBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Country_Of_Birth}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="BirthCountryCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Permit_PlaceOfBirthTown}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BirthTownBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Permit_SecondCitizenship}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SecondCitizenshipCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Permit_CurrentPermitType}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CurrentPermitTypeCombo" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Permit_CurrentPermitNumber}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CurrentPermitNumberBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Permit_ReferencePerson}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReferenceNameBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0">
                            <TextBlock Text="{res:Str Key=Permit_ReferencePhone}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReferencePhoneBox" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1">
                            <TextBlock Text="{res:Str Key=Permit_ChildrenBornHere}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChildrenBornBox" Width="70" HorizontalAlignment="Left" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2">
                            <TextBlock Text="{res:Str Key=Permit_ChildrenLivingHere}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChildrenLivingBox" Width="70" HorizontalAlignment="Left" Style="{StaticResource FieldBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <WrapPanel>
                                <TextBlock Text="{res:Str Key=Permit_PeopleLiveWith}" VerticalAlignment="Center" Margin="0,0,6,8"/>
                                <TextBox x:Name="PeopleLiveWithBox" Width="60" Style="{StaticResource FieldBox}"/>
                                <CheckBox x:Name="StayMoreCheck" Content="{res:Str Key=Permit_IntendedToStayMore}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="FixJobCheck" Content="{res:Str Key=Permit_HadFixJob}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="CitizenFamilyCheck" Content="{res:Str Key=Permit_CitizenFamilyMember}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChildrenBornHereCheck" Content="{res:Str Key=Permit_HasChildrenBornHere}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="LivingMigrantsCheck" Content="{res:Str Key=Permit_LivingWithMigrants}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChildrenSameHouseCheck" Content="{res:Str Key=Permit_ChildrenSameHouse}" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChildrenEducationCheck" Content="{res:Str Key=Permit_ChildrenEducation}" Margin="0,0,16,8"/>
                            </WrapPanel>
                            <Button Content="{res:Str Key=Permit_SaveDetails}" Style="{StaticResource PrimaryButton}" Padding="16,6"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="SaveDetails_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ CONTACTS / CONDUITE / ANTÉCÉDENTS ============ -->
            <TabItem Header="{res:Str Key=Permit_Section_Contacts}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{res:Str Key=Permit_ContactType}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ContactTypeCombo" Width="170" Style="{StaticResource FieldCombo}"/>
                        <TextBlock Text="{res:Str Key=Permit_ContactDesc}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ContactDescBox" Width="280" Style="{StaticResource FieldBox}"/>
                        <Button Content="{res:Str Key=Permit_Add}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="AddContact_Click"/>
                        <Button Content="{res:Str Key=Permit_Remove}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="RemoveContact_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ContactsGrid" Grid.Row="1" Height="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Permit_ContactType}" Binding="{Binding ContactTypeId}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=Permit_ContactDesc}" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="{res:Str Key=Permit_LicenseCountry}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LicenseCountryCombo" Width="200" Style="{StaticResource FieldCombo}"/>
                        <TextBlock Text="{res:Str Key=Permit_LicenseNumber}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="LicenseNumberBox" Width="180" Style="{StaticResource FieldBox}"/>
                        <Button Content="{res:Str Key=Permit_Add}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="AddLicense_Click"/>
                        <Button Content="{res:Str Key=Permit_Remove}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="RemoveLicense_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="LicensesGrid" Grid.Row="3" Height="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Permit_LicenseCountry}" Binding="{Binding CountryOfIssueId}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=Permit_LicenseNumber}" Binding="{Binding Number}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="{res:Str Key=Permit_RecordType}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RecordTypeBox" Width="160" Style="{StaticResource FieldBox}"/>
                        <TextBlock Text="{res:Str Key=Permit_ContactDesc}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="RecordDescBox" Width="300" Style="{StaticResource FieldBox}"/>
                        <Button Content="{res:Str Key=Permit_Add}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="AddRecord_Click"/>
                        <Button Content="{res:Str Key=Permit_Remove}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="RemoveRecord_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="RecordsGrid" Grid.Row="5" Height="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Permit_RecordType}" Binding="{Binding RecordType}" Width="150"/>
                            <DataGridTextColumn Header="{res:Str Key=Permit_ContactDesc}" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== VOYAGE & ACTIVITÉ ===================== -->
            <TabItem Header="{res:Str Key=Permit_Section_Travel}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=PAL_TravelReason}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TravelReasonCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=PAL_Transport}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TravelTransportCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_TravelDeparture}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DepartureTownBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=PAL_DestinationCountry}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DepartureCountryCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_TravelDepartureDate}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DeparturePicker" Margin="0,0,12,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_TravelArrival}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ArrivalPicker" Margin="0,0,12,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                        <TextBlock Text="{res:Str Key=Permit_TravelPort}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PortCombo" Style="{StaticResource FieldCombo}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_SelfEmployedName}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BusinessNameBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <WrapPanel>
                            <CheckBox x:Name="FreeWillCheck" Content="{res:Str Key=Permit_TravelFreeWill}" Margin="0,0,16,8"/>
                            <CheckBox x:Name="ImmigrationCheckCheck" Content="{res:Str Key=Permit_TravelImmigrationCheck}" Margin="0,0,16,8"/>
                            <CheckBox x:Name="IrregularExitCheck" Content="{res:Str Key=Permit_TravelIrregularExit}" Margin="0,0,16,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="{res:Str Key=Permit_SelfEmployedAddress}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BusinessAddressBox" Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{res:Str Key=Permit_SaveTravel}" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="SaveTravel_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== DÉPENDANTS ===================== -->
            <TabItem Header="{res:Str Key=Permit_Section_Dependants}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=PAL_Surname}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DepSurnameBox" Width="140" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=PAL_GivenName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DepGivenNameBox" Width="140" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=PAL_DateOfBirth}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="DepBirthPicker" Width="120" Margin="0,0,12,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=Permit_Dependant_Relation}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DepRelationCombo" Width="140" Style="{StaticResource FieldCombo}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=PAL_DocumentNumber}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DepDocumentBox" Width="130" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{res:Str Key=Permit_Dependant_Phone}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DepPhoneBox" Width="120" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                            <Button Content="{res:Str Key=Permit_Dependant_Add}" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0" Click="AddDependant_Click"/>
                            <Button Content="{res:Str Key=Permit_Dependant_Edit}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="UpdateDependant_Click"/>
                            <Button Content="{res:Str Key=Permit_Remove}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="RemoveDependant_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="DependantsGrid" Grid.Row="1" SelectionChanged="Dependant_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=PAL_Surname}" Binding="{Binding Surname}" Width="160"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_GivenName}" Binding="{Binding GivenName}" Width="160"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_DateOfBirth}" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=Permit_Dependant_Relation}" Binding="{Binding RelationId}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_DocumentNumber}" Binding="{Binding DocumentNumber}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=Permit_Dependant_Phone}" Binding="{Binding PhoneNumber}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="DependantHint" Foreground="#8A8F99" FontSize="12"
                               Text="{res:Str Key=Permit_RequiresSaved}" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- ===================== ANTÉCÉDENTS MÉDICAUX ===================== -->
            <TabItem Header="{res:Str Key=RP_Section_MedicalHistory}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="{res:Str Key=PM_Dependant}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <ComboBox x:Name="MedicalDependantCombo" Width="220" Style="{StaticResource FieldCombo}" Margin="0,0,12,0"
                                  SelectionChanged="MedicalDependant_Changed"/>
                        <TextBlock Text="{res:Str Key=PM_CurrentIllness}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="MedicalIllnessBox" Width="220" Style="{StaticResource FieldBox}" Margin="0,0,12,0"/>
                        <TextBlock Text="{res:Str Key=PM_CurrentMedication}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="MedicalMedicationBox" Width="200" Style="{StaticResource FieldBox}"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveMedicalBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" Margin="0,0,8,0" Click="SaveMedical_Click"/>
                            <Button x:Name="PrintMedicalBtn" Content="{res:Str Key=RP_Report_MedicalHistory}" Style="{StaticResource ToolbarButton}"
                                    Padding="14,6" Margin="0,0,8,0" Click="PrintMedical_Click"/>
                            <TextBlock x:Name="MedicalHint" Text="{res:Str Key=PM_RequiresSaved}" VerticalAlignment="Center" Foreground="#8A8F99"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <GroupBox Header="{res:Str Key=RP_Section_Suffered}" Width="330" Margin="0,0,10,8">
                                <StackPanel Margin="6">
                                    <CheckBox x:Name="MedMalaria" Content="{res:Str Key=PM_Malaria}" Margin="0,2"/>
                                    <CheckBox x:Name="MedYellowFever" Content="{res:Str Key=PM_YellowFever}" Margin="0,2"/>
                                    <CheckBox x:Name="MedTuberculosis" Content="{res:Str Key=PM_Tuberculosis}" Margin="0,2"/>
                                    <CheckBox x:Name="MedMeasles" Content="{res:Str Key=PM_Measles}" Margin="0,2"/>
                                    <CheckBox x:Name="MedCholera" Content="{res:Str Key=PM_Cholera}" Margin="0,2"/>
                                    <CheckBox x:Name="MedTyphoid" Content="{res:Str Key=PM_Typhoid}" Margin="0,2"/>
                                    <CheckBox x:Name="MedJaundice" Content="{res:Str Key=PM_Jaundice}" Margin="0,2"/>
                                    <CheckBox x:Name="MedChronicCough" Content="{res:Str Key=PM_ChronicCough}" Margin="0,2"/>
                                    <TextBlock Text="{res:Str Key=PM_OtherSuffered}" Margin="0,6,0,2"/>
                                    <TextBox x:Name="MedOtherSufferedBox" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{res:Str Key=RP_Section_Vaccinated}" Width="330" Margin="0,0,10,8">
                                <StackPanel Margin="6">
                                    <CheckBox x:Name="MedVaccinatedYellowFever" Content="{res:Str Key=PM_YellowFever}" Margin="0,2"/>
                                    <CheckBox x:Name="MedVaccinatedMMR" Content="{res:Str Key=PM_MMR}" Margin="0,2"/>
                                    <CheckBox x:Name="MedVaccinatedDiphtheria" Content="{res:Str Key=PM_Diphtheria}" Margin="0,2"/>
                                    <CheckBox x:Name="MedVaccinatedPolio" Content="{res:Str Key=PM_Polio}" Margin="0,2"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{res:Str Key=RP_Section_CurrentHealth}" Width="330" Margin="0,0,10,8">
                                <StackPanel Margin="6">
                                    <CheckBox x:Name="MedChronicDisease" Content="{res:Str Key=PM_ChronicDisease}" Margin="0,2"/>
                                    <CheckBox x:Name="MedInfectiousDisease" Content="{res:Str Key=PM_InfectiousDisease}" Margin="0,2"/>
                                    <CheckBox x:Name="MedHealthCentre" Content="{res:Str Key=PM_HealthCentreVisited}" Margin="0,2"/>
                                    <CheckBox x:Name="MedPublicHealthCentre" Content="{res:Str Key=PM_PublicHealthCentre}" Margin="0,2"/>
                                    <TextBlock x:Name="MedicalUpdatedText" Margin="0,8,0,0" Foreground="#4A5568"/>
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

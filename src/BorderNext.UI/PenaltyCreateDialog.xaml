<Window x:Class="BorderNext.UI.PenaltyCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=ENF_Penalty_Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#4A5568"/>

        <TextBlock Text="{res:Str Key=ENF_Penalty_Reason}" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ReasonCombo" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock Text="{res:Str Key=ENF_Penalty_Amount}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AmountBox" Width="110" Style="{StaticResource FieldBox}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{res:Str Key=ENF_Penalty_Currency}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CurrencyBox" Width="70" Style="{StaticResource FieldBox}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{res:Str Key=ENF_Penalty_Duration}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DurationBox" Width="80" Style="{StaticResource FieldBox}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{res:Str Key=ENF_Penalty_Number}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
        <TextBox x:Name="NumberBox" Margin="0,0,0,10"/>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{res:Str Key=PAL_Save}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="{res:Str Key=Common_Cancel}" Padding="16,8" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

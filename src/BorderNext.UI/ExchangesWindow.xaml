<Window x:Class="BorderNext.UI.ExchangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=EX_Title}"
        Height="820" Width="1340"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#4A5568"/>
                <Button Content="{res:Str Key=PAL_Close}" Padding="16,8" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">
            <!-- ===================== MESSAGES APIS ===================== -->
            <TabItem Header="{res:Str Key=EX_Tab_Messages}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{res:Str Key=EX_From}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="MessageFromPicker" Width="120" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=Admin_Audit_To}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="MessageToPicker" Width="120" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=EX_Col_Flight}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="MessageFlightBox" Width="110" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <TextBlock Text="{res:Str Key=EX_Col_Status}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="MessageStatusCombo" Width="140" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Margin="0,0,8,0" Click="SearchMessages_Click"/>
                        <Button x:Name="ImportPaxlstBtn" Content="{res:Str Key=EX_ImportPaxlst}" Style="{StaticResource PrimaryButton}" Padding="12,4" Margin="0,0,8,0" Click="ImportPaxlst_Click"/>
                        <Button x:Name="ExportPaxlstBtn" Content="{res:Str Key=EX_ExportPaxlst}" Style="{StaticResource ToolbarButton}" Padding="12,4" Margin="0,0,8,0" Click="ExportPaxlst_Click"/>
                        <Button Content="{res:Str Key=EX_ExportXml}" Style="{StaticResource ToolbarButton}" Padding="12,4" Margin="0,0,8,0" Click="ExportXml_Click"/>
                        <Button Content="{res:Str Key=EX_GenerateFromMovements}" Style="{StaticResource ToolbarButton}" Padding="12,4" Click="GenerateFromMovements_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="MessagesGrid" Grid.Row="1" SelectionChanged="Message_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Admin_Col_Date}" Binding="{Binding CreatedDateFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Flight}" Binding="{Binding FlightLabel}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Departure}" Binding="{Binding DepartureLocation}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Arrival}" Binding="{Binding ArrivalLocation}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_ArrivalDate}" Binding="{Binding ArrivalDateFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Passengers}" Binding="{Binding PassengerCount}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Status}" Binding="{Binding StatusFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Sender}" Binding="{Binding SenderId}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Files}" Binding="{Binding FileCount}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="{res:Str Key=EX_PassengersOfMessage}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MessageDetailText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#4A5568"/>
                    </StackPanel>

                    <DataGrid x:Name="PassengersGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Type}" Binding="{Binding TypeFr}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Surname}" Binding="{Binding Surname}" Width="150"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_GivenName}" Binding="{Binding GivenName}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Document}" Binding="{Binding DocumentNumber}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_BirthDate}" Binding="{Binding BirthDateFr}" Width="95"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Citizenship}" Binding="{Binding Citizenship}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Sex}" Binding="{Binding Gender}" Width="60"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Status}" Binding="{Binding StatusFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Reason}" Binding="{Binding CheckingReason}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Matched}" Binding="{Binding MatchedFr}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== PASSAGERS DOUTEUX ===================== -->
            <TabItem Header="{res:Str Key=EX_Tab_Doubtful}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="ShowProcessedCheck" Content="{res:Str Key=EX_ShowProcessed}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="DoubtfulFilter_Changed" Unchecked="DoubtfulFilter_Changed"/>
                        <CheckBox x:Name="AutoCheckBox" Content="{res:Str Key=WL_AutoCheck}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
                        <Button Content="{res:Str Key=EX_Refresh}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="RefreshDoubtful_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="DoubtfulGrid" Grid.Row="1" SelectionChanged="Doubtful_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Admin_Col_Date}" Binding="{Binding CreateDateFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_Col_Holder}" Binding="{Binding PassengerName}" Width="180"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Document}" Binding="{Binding DocumentNumber}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Flight}" Binding="{Binding FlightLabel}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Reason}" Binding="{Binding ReasonFr}" Width="230"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_ActionStatus}" Binding="{Binding StatusFr}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Supervisor}" Binding="{Binding Supervisor}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Note}" Binding="{Binding SupervisorsNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{res:Str Key=WL_Col_Action}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DecisionActionCombo" Width="230" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                            <TextBlock Text="{res:Str Key=EX_Col_Note}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="DecisionNoteBox" Width="330" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                            <Button x:Name="ProcessDoubtfulBtn" Content="{res:Str Key=EX_Decide}" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="ProcessDoubtful_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== CONTRÔLES EXTERNES ===================== -->
            <TabItem Header="{res:Str Key=EX_Tab_Checks}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{res:Str Key=EX_Check_DocumentType}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="CheckDocumentTypeBox" Width="70" Style="{StaticResource FieldBox}" Margin="0,0,10,0" Text="P"/>
                        <TextBlock Text="{res:Str Key=WL_Col_Document}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="CheckDocumentBox" Width="130" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=WL_Col_Surname}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="CheckSurnameBox" Width="130" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=WL_Col_GivenName}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <TextBox x:Name="CheckGivenNameBox" Width="120" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=WL_Col_BirthDate}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <DatePicker x:Name="CheckBirthPicker" Width="120" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=EX_Check_Expiry}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                        <DatePicker x:Name="CheckExpiryPicker" Width="120" Margin="0,0,10,0"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="CheckAllBtn" Content="{res:Str Key=EX_Check_All}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" Click="CheckAll_Click"/>
                        <Button x:Name="CheckSimiecBtn" Content="{res:Str Key=EX_Connector_Simiec}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,8,0" Click="CheckSimiec_Click"/>
                        <Button x:Name="CheckBelizeBtn" Content="{res:Str Key=EX_Connector_Belize}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,8,0" Click="CheckBelize_Click"/>
                        <Button x:Name="CheckAirBtn" Content="{res:Str Key=EX_Connector_Air}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="CheckAir_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="CheckResultsGrid" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Time}" Binding="{Binding TimeFr}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Connector}" Binding="{Binding ConnectorName}" Width="200"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Verdict}" Binding="{Binding VerdictFr}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Reference}" Binding="{Binding Reference}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Mode}" Binding="{Binding ModeFr}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Summary}" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== JOURNAL ===================== -->
            <TabItem Header="{res:Str Key=EX_Tab_Journal}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{res:Str Key=EX_Col_Channel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="JournalChannelCombo" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=EX_Col_Direction}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="JournalDirectionCombo" Width="120" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=EX_From}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="JournalFromPicker" Width="120" Margin="0,0,4,0"/>
                        <TextBlock Text="{res:Str Key=Admin_Audit_To}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="JournalToPicker" Width="120" Margin="0,0,10,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Click="SearchJournal_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="RunsGrid" Grid.Row="1" SelectionChanged="Run_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=Admin_Col_Date}" Binding="{Binding StartedFr}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Channel}" Binding="{Binding ChannelFr}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Direction}" Binding="{Binding DirectionFr}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Reference}" Binding="{Binding Reference}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Status}" Binding="{Binding StatusFr}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Items}" Binding="{Binding CountsFr}" Width="120"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Summary}" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{res:Str Key=EX_ErrorsOfRun}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DataGrid x:Name="ErrorsGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Time}" Binding="{Binding OccurredFr}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Step}" Binding="{Binding Step}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Item}" Binding="{Binding ItemReference}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Summary}" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== CONNECTEURS ===================== -->
            <TabItem Header="{res:Str Key=EX_Tab_Connectors}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ConnectorsGrid" Grid.Row="0" SelectionChanged="Connector_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Connector}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Channel}" Binding="{Binding Channel}" Width="100"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Endpoint}" Binding="{Binding Endpoint}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=EX_Col_Mode}" Binding="{Binding ModeFr}" Width="90"/>
                            <DataGridCheckBoxColumn Header="{res:Str Key=EX_Col_Active}" Binding="{Binding IsActive, Mode=OneWay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{res:Str Key=EX_Col_Endpoint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="EndpointBox" Width="330" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=EX_Col_Mode}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ModeCombo" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <CheckBox x:Name="ActiveCheck" Content="{res:Str Key=EX_Col_Active}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="SaveConnectorBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="SaveConnector_Click"/>
                            </StackPanel>

                            <!-- Jeton du partenaire : chiffré au repos, jamais réaffiché en clair. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{res:Str Key=EX_Connector_Secret}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <PasswordBox x:Name="SecretBox" Width="240" Padding="8,5" Margin="0,0,10,0"/>
                                <Button x:Name="SaveSecretBtn" Content="{res:Str Key=EX_Connector_SecretSave}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,6,0" Click="SaveSecret_Click"/>
                                <Button x:Name="ClearSecretBtn" Content="{res:Str Key=EX_Connector_SecretClear}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,10,0" Click="ClearSecret_Click"/>
                                <TextBlock x:Name="SecretStatusText" VerticalAlignment="Center" Foreground="#8A8F99"/>
                            </StackPanel>

                            <!-- Rétention : purge des fichiers d'échange anciens (réglage Exchange_MessageRetentionDays). -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="RetentionText" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#8A8F99"/>
                                <Button x:Name="PurgePreviewBtn" Content="{res:Str Key=EX_PurgePreview}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,6,0" Click="PurgePreview_Click"/>
                                <Button x:Name="PurgeFilesBtn" Content="{res:Str Key=EX_PurgeFiles}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="PurgeFiles_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="BorderNext.UI.FingerprintsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=Bio_Title}"
        Height="560" Width="940"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                BorderThickness="0,0,0,1" Padding="10">
            <StackPanel>
                <TextBlock x:Name="PersonText" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="DeviceText" Foreground="#4A5568" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#4A5568"/>
                <Button Content="{res:Str Key=PAL_Close}" Padding="16,8" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="FingersGrid" Grid.Column="0" SelectionChanged="Finger_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{res:Str Key=Bio_Col_Finger}" Binding="{Binding Display}" Width="*"/>
                    <DataGridCheckBoxColumn Header="{res:Str Key=Bio_Col_Captured}" Binding="{Binding Captured}" Width="90"/>
                    <DataGridTextColumn Header="{res:Str Key=Bio_Col_Quality}" Binding="{Binding Quality}" Width="80"/>
                    <DataGridTextColumn Header="{res:Str Key=Bio_Col_Date}" Binding="{Binding CaptureDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="{res:Str Key=Bio_Col_Device}" Binding="{Binding Device}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Border BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="1" Height="300" Background="White">
                    <Image x:Name="Preview" Stretch="Uniform"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{res:Str Key=Bio_Capture}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,6,0" Click="Capture_Click"/>
                    <Button Content="{res:Str Key=Bio_Show}" Style="{StaticResource ToolbarButton}" Padding="10,6" Click="Show_Click"/>
                    <Button Content="{res:Str Key=Bio_Delete}" Style="{StaticResource ToolbarButton}" Padding="10,6" Click="Delete_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

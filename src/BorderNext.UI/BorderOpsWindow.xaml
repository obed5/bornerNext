<Window x:Class="BorderNext.UI.BorderOpsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=BO_Title}"
        Height="820" Width="1340"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#4A5568"/>
                <Button Content="{res:Str Key=PAL_Close}" Padding="16,8" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">
            <!-- ===================== VOYAGES ===================== -->
            <TabItem Header="{res:Str Key=BO_Tab_Trips}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{res:Str Key=BO_Col_Type}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="TripTypeFilter" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=Admin_Audit_From}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="TripFromPicker" Width="120" Margin="0,0,10,0"/>
                        <TextBlock Text="{res:Str Key=Admin_Audit_To}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker x:Name="TripToPicker" Width="120" Margin="0,0,10,0"/>
                        <CheckBox x:Name="TripOnlyOpen" Content="{res:Str Key=BO_OnlyOpen}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Margin="0,0,8,0" Click="SearchTrips_Click"/>
                        <Button x:Name="NewTripBtn" Content="{res:Str Key=BO_NewTrip}" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="NewTrip_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="TripsGrid" Grid.Row="1" SelectionChanged="Trip_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_WorkflowStatus}" Binding="{Binding IsOpen}" Width="60"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Name}" Binding="{Binding Name}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Type}" Binding="{Binding TypeFr}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_TravelDate}" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="95"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_Col_Direction}" Binding="{Binding DirectionFr}" Width="90"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_From}" Binding="{Binding FromTerminal}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_To}" Binding="{Binding ToTerminal}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Carrier}" Binding="{Binding CarrierName}" Width="150"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Passengers}" Binding="{Binding PassengerCount}" Width="70"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_OpenTime}" Binding="{Binding OpenTime, StringFormat=hh\:mm}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_CloseTime}" Binding="{Binding CloseTime, StringFormat=hh\:mm}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{res:Str Key=BO_Col_Name}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TripNameEdit" Width="90" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Type}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TripTypeEdit" Width="110" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=PAL_Col_Direction}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TripDirectionEdit" Width="110" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=WL_Col_TravelDate}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <DatePicker x:Name="TripDateEdit" Width="120" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_ScheduledTime}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TripScheduledEdit" Width="60" Style="{StaticResource FieldBox}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{res:Str Key=BO_Col_From}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TripFromTerminal" Width="190" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_To}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TripToTerminal" Width="190" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Carrier}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TripCarrierEdit" Width="190" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_ExternalNumber}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TripExternalEdit" Width="90" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=WL_Col_Info}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TripDescriptionEdit" Width="200" Style="{StaticResource FieldBox}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SaveTripBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,6,0" Click="SaveTrip_Click"/>
                                <Button x:Name="OpenTripBtn" Content="{res:Str Key=BO_ToggleOpen}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,6,0" Click="ToggleOpen_Click"/>
                                <Button x:Name="DeleteTripBtn" Content="{res:Str Key=Common_Revoke}" Style="{StaticResource ToolbarButton}" Padding="12,6" Margin="0,0,14,0" Click="DeleteTrip_Click"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Passengers}" VerticalAlignment="Center" Margin="0,4,8,0"/>
                                <ComboBox x:Name="ReassignTarget" Width="240" Style="{StaticResource FieldCombo}" Margin="0,0,6,0"/>
                                <Button x:Name="ReassignBtn" Content="{res:Str Key=BO_Reassign}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="Reassign_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PassengersGrid" Grid.Row="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Document}" Binding="{Binding DocumentNumber}" Width="140"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_Col_Holder}" Binding="{Binding HolderName}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_TravelDate}" Binding="{Binding TravelDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="{res:Str Key=PAL_Col_Direction}" Binding="{Binding DirectionFr}" Width="90"/>
                            <DataGridCheckBoxColumn Header="{res:Str Key=PAL_Granted}" Binding="{Binding Granted}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== NAVIRES ===================== -->
            <TabItem Header="{res:Str Key=BO_Tab_Vessels}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="VesselSearch" Width="240" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Margin="0,0,8,0" Click="SearchVessels_Click"/>
                        <Button x:Name="NewVesselBtn" Content="{res:Str Key=WL_NewEntry}" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="NewVessel_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="VesselsGrid" Grid.Row="1" SelectionChanged="Vessel_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Name}" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_FormerName}" Binding="{Binding FormerName}" Width="160"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Registration}" Binding="{Binding RegistrationNumber}" Width="130"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Type}" Binding="{Binding TypeFr}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Nationality}" Binding="{Binding NationalityFr}" Width="160"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_HomePort}" Binding="{Binding HomePortFr}" Width="150"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_CallSign}" Binding="{Binding RadioCallSign}" Width="100"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_RegistrationDate}" Binding="{Binding RegistrationDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{res:Str Key=BO_Col_Name}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselNameEdit" Width="200" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_FormerName}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselFormerNameEdit" Width="170" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Registration}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselRegistrationEdit" Width="120" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Type}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="VesselTypeEdit" Width="140" Style="{StaticResource FieldCombo}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{res:Str Key=BO_Col_Nationality}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="VesselNationalityEdit" Width="180" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_HomePort}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="VesselHomePortEdit" Width="180" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Dimension}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselDimensionEdit" Width="80" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Color}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselColorEdit" Width="80" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_CallSign}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselCallSignEdit" Width="80" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Frequencies}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="VesselFrequenciesEdit" Width="80" Style="{StaticResource FieldBox}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SaveVesselBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="SaveVessel_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== TRANSPORTEURS ===================== -->
            <TabItem Header="{res:Str Key=BO_Tab_Carriers}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="CarrierSearch" Width="240" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CarrierTypeFilter" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Margin="0,0,8,0" Click="SearchCarriers_Click"/>
                        <Button x:Name="NewCarrierBtn" Content="{res:Str Key=WL_NewEntry}" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="NewCarrier_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="CarriersGrid" Grid.Row="1" SelectionChanged="Carrier_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Code}" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_DisplayName}" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Type}" Binding="{Binding TransportType.Code}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Country}" Binding="{Binding Country.Alpha3}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{res:Str Key=BO_Col_Code}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="CarrierCodeEdit" Width="80" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_DisplayName}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="CarrierFrEdit" Width="240" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Type}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="CarrierTypeEdit" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=WL_Col_Country}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="CarrierCountryEdit" Width="180" Style="{StaticResource FieldCombo}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SaveCarrierBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,6,0" Click="SaveCarrier_Click"/>
                                <Button x:Name="RevokeCarrierBtn" Content="{res:Str Key=Common_Revoke}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="ToggleCarrierRevoked_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== TERMINAUX ===================== -->
            <TabItem Header="{res:Str Key=BO_Tab_Terminals}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox x:Name="TerminalSearch" Width="240" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TerminalTypeFilter" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"/>
                        <Button Content="{res:Str Key=Common_Search}" Style="{StaticResource ToolbarButton}" Padding="10,4" Margin="0,0,8,0" Click="SearchTerminals_Click"/>
                        <Button x:Name="NewTerminalBtn" Content="{res:Str Key=WL_NewEntry}" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="NewTerminal_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="TerminalsGrid" Grid.Row="1" SelectionChanged="Terminal_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Code}" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_DisplayName}" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_Type}" Binding="{Binding TransportType.Code}" Width="110"/>
                            <DataGridTextColumn Header="{res:Str Key=WL_Col_Country}" Binding="{Binding Country.Alpha3}" Width="80"/>
                            <DataGridTextColumn Header="{res:Str Key=BO_Col_City}" Binding="{Binding City.ExternalId}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource ThemePanelBrush}" BorderBrush="{StaticResource ThemeBorderBrush}"
                            BorderThickness="1" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{res:Str Key=BO_Col_Code}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TerminalCodeEdit" Width="80" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_DisplayName}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <TextBox x:Name="TerminalFrEdit" Width="220" Style="{StaticResource FieldBox}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_Type}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TerminalTypeEdit" Width="130" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=WL_Col_Country}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TerminalCountryEdit" Width="180" Style="{StaticResource FieldCombo}" Margin="0,0,10,0"/>
                                <TextBlock Text="{res:Str Key=BO_Col_City}" VerticalAlignment="Center" Margin="0,4,4,0"/>
                                <ComboBox x:Name="TerminalCityEdit" Width="180" Style="{StaticResource FieldCombo}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SaveTerminalBtn" Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,6,0" Click="SaveTerminal_Click"/>
                                <Button x:Name="RevokeTerminalBtn" Content="{res:Str Key=Common_Revoke}" Style="{StaticResource ToolbarButton}" Padding="12,6" Click="ToggleTerminalRevoked_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

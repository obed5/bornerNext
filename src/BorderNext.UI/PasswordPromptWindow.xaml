<Window x:Class="BorderNext.UI.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{res:Str Key=PasswordPrompt_Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{res:Str Key=ChangePassword_New}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordInput" Padding="4,3" Margin="0,0,0,10"/>
        <TextBlock Text="{res:Str Key=ChangePassword_Confirm}" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="ConfirmInput" Padding="4,3" Margin="0,0,0,10"/>
        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{res:Str Key=Common_Save}" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="{res:Str Key=Common_Cancel}" Padding="12,8" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

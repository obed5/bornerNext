<Window x:Class="BorderNext.UI.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:BorderNext.UI.Resources"
        Title="{x:Static res:Strings.ChangePassword_Title}"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.ChangePassword_Info}"
                   TextWrapping="Wrap" Foreground="#333" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.ChangePassword_Current}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentBox" Padding="8,6"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.ChangePassword_New}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewBox" Padding="8,6"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.ChangePassword_Confirm}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" Padding="8,6"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#C00000" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <Button Grid.Row="6" Content="{x:Static res:Strings.ChangePassword_Button}"
                Style="{StaticResource PrimaryButton}" Height="38" Click="Apply_Click" IsDefault="True"/>
    </Grid>
</Window>

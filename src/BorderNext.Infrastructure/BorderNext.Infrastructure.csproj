<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BorderNext.Application\BorderNext.Application.csproj" />
    <ProjectReference Include="..\BorderNext.Domain\BorderNext.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nomenclatures réelles extraites du système d'origine (aucune donnée personnelle). -->
    <EmbeddedResource Include="Persistence\Seeding\reference-data.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les tests vérifient le format de gabarit et la MRZ du simulateur (détails internes). -->
    <InternalsVisibleTo Include="BorderNext.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

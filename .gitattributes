# Normalisation des fins de ligne et des fichiers binaires.
# Les scripts PowerShell et les ressources .resx sont conservés en CRLF
# (PowerShell 5.1 lit les scripts accentués en ANSI sans BOM) ; les images
# et les fichiers de base ne sont jamais convertis.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.sln     text eol=crlf
*.resx    text eol=crlf
*.ps1     text eol=crlf
*.json    text
*.md      text

*.png     binary
*.jpg     binary
*.ico     binary
*.bak     binary
